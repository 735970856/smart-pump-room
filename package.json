{
  "name": "smart-pump-room-vue3",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "engines": {
    "node": ">=20.19.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "vue-tsc -b",
    "lint": "eslint src/main.ts src/App.vue src/views src/services src/styles vite.config.ts",
    "lint:fix": "eslint src/main.ts src/App.vue src/views src/services src/styles vite.config.ts --fix",
    "verify:assets": "node scripts/check-assets.mjs"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "element-plus": "^2.11.0",
    "three": "^0.180.0",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.0",
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^22.15.0",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-vue": "^5.2.0",
    "eslint": "^9.25.0",
    "eslint-plugin-vue": "^10.0.0",
    "globals": "^16.0.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.30.0",
    "vite": "^6.3.0",
    "vue-tsc": "^2.2.10"
  },
  "packageManager": "pnpm@10.19.0"
}
